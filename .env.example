# Runtime image identity is fixed by codestra/release/runtime-image.lock.json and
# deploy/compose.yaml. It is not caller-overridable.

CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_DATABASE_NETWORK=codestra-database
POSTGRES_EXPORTER_URI_SECRET=codestra-postgres-exporter-uri
POSTGRES_EXPORTER_USER_SECRET=codestra-postgres-exporter-user
POSTGRES_EXPORTER_PASSWORD_SECRET=codestra-postgres-exporter-password
