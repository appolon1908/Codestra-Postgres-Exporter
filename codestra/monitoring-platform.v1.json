{
  "schemaVersion": 1,
  "repository": "appolon1908-hue/Codestra-Postgres-Exporter",
  "service": "postgres-exporter",
  "plane": "telemetry-data-plane",
  "controller": "appolon1908-hue/Middleware- (service catalog, monitoring state, incidents)",
  "secretsAuthority": "appolon1908-hue/Codestra-OpenBao",
  "credentialPolicy": {
    "credentialFree": false,
    "openbaoWorkloadIdentity": "postgres-exporter",
    "openbaoPathPrefix": "codestra/<environment>/observability/exporters/postgres/",
    "secretReferences": "codestra/secret-references.v1.json",
    "secretMaterialInGit": false,
    "credentialsFromRuntimeFilesOnly": true
  },
  "listener": {
    "address": "0.0.0.0:9187",
    "exposure": "private_observability_network_only",
    "hostPortPublished": false,
    "internetIngress": false
  },
  "prometheus": {
    "scrapeJob": "codestra-targets",
    "targetId": "postgres-exporter",
    "consumerRepository": "appolon1908-hue/Codestra-Prometheus",
    "metricsOnly": true
  },
  "middlewareCatalog": {
    "serviceId": "postgres-exporter",
    "metricsProfile": "prometheus",
    "logsProfile": "alloy",
    "tracesProfile": "not-applicable",
    "expectedStateSource": "release image digest and config bundle digest"
  },
  "businessEffects": {
    "providerWrites": false,
    "businessApiCalls": false
  },
  "runtimeApplyAuthorized": false
}
