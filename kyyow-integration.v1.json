{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-Postgres-Exporter",
  "component": "postgres-exporter",
  "authority": "postgres-metrics",
  "exposure": "private",
  "native_ports": [
    9187
  ],
  "inputs": [
    "postgres:catalog-read-only"
  ],
  "outputs": [
    "alloy:metrics"
  ],
  "controls": [
    "dedicated least-privilege monitoring role only",
    "connection credentials arrive through OpenBao or mounted secret files",
    "customer rows and query text are never exported as labels",
    "no public listener"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
